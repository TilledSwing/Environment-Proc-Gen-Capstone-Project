// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel GrassCompute

struct Vertex
{
    float3 position;
    float3 normal;
};

struct Triangle
{
    Vertex v1;
    Vertex v2;
    Vertex v3;
};

struct GrassBlade 
{
    float3 position;
    float rotation;
    float height;
    float curve;
    float3 terrainNormal;
};

StructuredBuffer<Triangle> GrassTriangleBuffer;
AppendStructuredBuffer<GrassBlade> GrassPositionsBuffer;

int TriangleCount;
uint ChunkSize;
float3 ChunkPos;
int GrassDensity;

int MinHeight;
int MaxHeight;
float MaxSlope;

// Random hash function
float Hash(uint seed)
{
    seed ^= 2747636419u;
    seed *= 2654435769u;
    seed ^= seed >> 16;
    seed *= 2654435769u;
    seed ^= seed >> 16;
    seed *= 2654435769u;
    return (seed & 0x00FFFFFF) / 16777216.0;
}

[numthreads(64,1,1)]
void GrassCompute (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TriangleCount) 
        return ;

    Triangle tri = GrassTriangleBuffer[id.x];
    Vertex v1 = tri.v1;
    Vertex v2 = tri.v2;
    Vertex v3 = tri.v3;

    float3 crossProd = cross(v2.position - v1.position, v3.position - v1.position);
    float area = length(crossProd) * 0.5;

    int bladeCount = clamp((int)(area * GrassDensity), 1, 12);
    
    float3 normal = normalize(crossProd);

    if (dot(normal, float3(0,1,0)) < MaxSlope)
        return;

    for (int i = 0; i < bladeCount; i++)
    {
        float r1 = Hash(id.x * 73856093u + i);
        float r2 = Hash(id.x * 19349663u + i * 17u);

        float sqrtR1 = sqrt(r1);

        float u = 1 - sqrtR1;
        float v = sqrtR1 * (1 - r2);
        float w = sqrtR1 * r2;

        float3 pos = (u * v1.position + v * v2.position + w * v3.position);

        if (pos.y < MinHeight || pos.y > MaxHeight)
            continue;

        GrassBlade grassBlade;
        grassBlade.position = pos;
        grassBlade.curve = Hash(id.x * 27821056u + i);
        grassBlade.rotation = Hash(id.x * 83492791u + i) * 2 * 6.2831853;
        grassBlade.height = lerp(0.8, 1.2, Hash(id.x * 17432890u + i));
        grassBlade.terrainNormal = normal;

        GrassPositionsBuffer.Append(grassBlade);
    }
}